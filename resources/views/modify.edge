<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>LOOTOPIA - Modification de votre compte</title>
  {{ style('style') }}
</head>
<body>
  <nav>
    <div class="nav-left">
      <ul class="nav-list">
        <li class="pointer" onclick="location.href = '/home'">Accueil</li>
       <li class="pointer" onclick="location.href = '/player'">Joueur</li>
            <li class="pointer" onclick="location.href = '/organisator'">Organisateur</li>
            <li class="pointer" onclick="location.href = '/recompenses'">Récompenses disponibles</li>
            <li class="pointer" onclick="location.href = '/marketplace'">Marketplace</li>
            <li class="pointer" onclick="location.href = '/shop'">Boutique</li>
      </ul>
    </div>
    <div class="nav-right" id="user-info">
  </div>
  </nav>
  <section class="scroll_y_auto">
    <div class="float_div width_1_sur_2 no_display float_right scroll_y_auto_0" id="confirm_deconnect">
      <table>
        <tbody>
          <tr><td colspan="2">Veux-tu vraiment te déconnecter ?</td></tr>
          <tr>
            <td><button class="littlebutton" onclick="deconnecter()">Oui</button></td>
            <td><button class="littlebutton" onclick="fermer('confirm_deconnect')">Non</button></td>
          </tr>
        </tbody>
      </table>
    </div>
    <img src="/lootopia.webp" width="170" height="170" alt="LOOTOPIA" />
        <h1>Modification de tes informations : </h1>
        <table>
      <tbody>
        <tr><th>Login* :</th><td><input type="text" placeholder="Login" id="logini" /></td></tr>
        <tr><th>Email* :</th><td><input type="text" placeholder="Email" id="meli" /></td></tr>
        <tr>
          <th>New password* :</th>
          <td><input type="password" placeholder="Password" id="pwdi" />
            <button onclick="showPwd('pwdi')">Display password</button>
          </td>
        </tr>
        <tr>
          <th>New password (to reconfirm)* :</th>
          <td><input type="password" placeholder="Password" id="pwdf" />
            <button onclick="showPwd('pwdf')">Display password</button>
          </td>
        </tr>
        <tr><th>Telephone Number :</th><td><input type="text" placeholder="Telephone Number" id="telt" /></td></tr>

        <!-- Error messages -->
        <tr><td colspan="2" class="no_display rouge" id="empty">Les champs avec * ne peuvent pas être vides</td></tr>
        <tr><td colspan="2" class="no_display rouge" id="meme">Un compte possède déjà soit le login tu as saisi ou soit l'adresse email que tu as saisi. Merci de réessayer</td></tr>
        <tr><td colspan="2" class="no_display rouge" id="incorrecte">L'email ne respecte pas la norme classique</td></tr>
        <tr><td colspan="2" class="no_display rouge" id="diffp">Les mots de passes sont différents</td></tr>
        <tr><td colspan="2" class="no_display rouge" id="incorrectp">Le mot de passe ne respecte pas l'expression régulière ci-dessus.</td></tr>
        <tr><td colspan="2" class="no_display rouge" id="erreur">Une erreur s'est produite.</td></tr>

        <tr>
          <td><button class="bigbutton" id="sign">Valider les modifications</button></td>
          <td><button class="bigbutton" onclick="window.history.back()">Annuler les modifications</button></td>
        </tr>
      </tbody>
    </table>
  </section>
    <footer>
      <div class="nav-right">
        <ul class="nav-list">
          <li>© 2025 Ashley RAKOTOARISOA<br />Projet réalisé dans le cadre de Sup de Vinci</li>
        </ul>
    </div>
  </footer>
  <script type="module">
    import Cookie from 'https://cdn.jsdelivr.net/npm/js-cookie@3.0.1/dist/js.cookie.mjs'
      const username = Cookie.get('username')
      let userInfo = document.getElementById('user-info')
      var divs = ["confirm_deconnect"]

    if(username){
        userInfo.innerHTML = "<img src='/account.webp' onclick='ouvrir("+'"info_account"'+")' class='pointer' alt='Profil' width='30' height='30' /><span>"+username+'</span><button onclick="ouvrir('+"'confirm_deconnect'"+')" class="buttond">Déconnexion</button>'
      } else {
        location.href = "/"
      }
      chargement()

      window.ouvrir = function(div){
        document.getElementById(div).style.display = "block"
        document.getElementById(div).scrollTop = 0
        for (let i = 0 ; i < divs.length ; i++){
          if (divs[i] != div){
            fermer(divs[i])
          }
        }
      }

       window.fermer = function(div) {
          document.getElementById(div).style.display = "none"
      }

      window.deconnecter = function(){
        Cookie.remove("username")
        location.href = "/"
      }

      async function chargement(){
        const response = await fetch("http://127.0.0.1:3334/data/postgresql/compte")
        const r = await response.json()
        const indexu = r.findIndex(obj => obj.login == username)
        document.getElementById("logini").value = r[indexu].nickname
        document.getElementById("meli").value = r[indexu].login
        document.getElementById("telt").value = r[indexu].tel
      }
    </script>
</body>
</html>