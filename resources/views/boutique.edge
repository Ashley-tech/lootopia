<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>LOOTOPIA - Boutique</title>
  {{ style('style') }}
</head>
<body>
  <nav>
    <div class="nav-left">
      <ul class="nav-list">
        <li class="pointer" onclick="location.href = '/home'">Accueil</li>
       <li class="pointer" onclick="location.href = '/player'">Joueur</li>
            <li class="pointer" onclick="location.href = '/organisator'">Organisateur</li>
            <li class="pointer" onclick="location.href = '/recompenses'">Récompenses disponibles</li>
            <li class="pointer" onclick="location.href = '/marketplace'">Marketplace</li>
            <li class="pointer" onclick="location.href = '/shop'">Boutique</li>
      </ul>
    </div>
    <div class="nav-right" id="user-info">
  </div>
  </nav>
  <section class="scroll_y_auto">
    <img src="/lootopia.webp" width="170" height="170" alt="LOOTOPIA" /><br />
    <h1>Boutique</h1><br />
    <div id="moneys">

    </div>
    <div class="float_div width_1_sur_2 no_display float_right scroll_y_auto_0" id="info_account">
      <table>
        <tbody>
          <tr><th colspan="2">Informations</th></tr>
          <tr><th>Nickname :</th><td id='nickname'></td></tr>
          <tr><th>Login :</th><td id='login'></td></tr>
          <tr><th>Password :</th><td id='password'></td></tr>
          <tr><th>Telephone Number :</th><td id='tel'></td></tr>
          <tr>
            <td><button class="littlebutton" onclick="location.href = 'account/modify'">Modifier</button></td>
            <td><button class="littlebutton" onclick="fermer('info_account')">Fermer</button></td>
          </tr>
        </tbody>
      </table>
    </div>
     <div class="float_div width_1_sur_2 no_display float_right scroll_y_auto_0" id="confirm_deconnect">
      <table>
        <tbody>
          <tr><td colspan="2">Veux-tu vraiment te déconnecter ?</td></tr>
          <tr>
            <td><button class="littlebutton" onclick="deconnecter()">Oui</button></td>
            <td><button class="littlebutton" onclick="fermer('confirm_deconnect')">Non</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <footer>
    <div class="nav-right">
      <ul class="nav-list">
        <li>© 2025 Ashley RAKOTOARISOA<br />Projet réalisé dans le cadre de Sup de Vinci</li>
      </ul>
  </div>
</footer>
<script src="https://js.stripe.com/v3/"></script>
<script type="module">
  import Cookie from 'https://cdn.jsdelivr.net/npm/js-cookie@3.0.1/dist/js.cookie.mjs'
  const stripe = Stripe('pk_test_51RbljMGKnjvSr5TJYgsFywCZ3vGQhXHMXEKBdHfyuqUlde4UwN30c64XJ0B8opgNKotlhqYideBL27jMe9Tx5DJU00ELFT02BL'); // clé publique
  const elements = stripe.elements();
let cardElements = [];

      const username = Cookie.get('username')
      let userInfo = document.getElementById('user-info')

      var moneys = document.getElementById("moneys")

      var divs = ["confirm_deconnect","info_account"]

      chargement()

      async function chargement() {
  const repon = await fetch("http://127.0.0.1:3334/data/postgresql/compte");
  const r = await repon.json();
  if (r.success){
    const inr = r.findIndex(obj => obj.login == username);
    const compteId = r[inr].id;
  }

  const response = await fetch("http://127.0.0.1:3334/data/mongodb/monnaie");
  const res = await response.json();

  for (let i = 0; i < res.length; i++) {
    const div = document.createElement('div');
    div.innerHTML = "<div style='margin: 20px 0; display: flex; align-items: center; gap: 10px;'><img src='/recompense/Monnaie virtuelle/"+res[i].nom+".webp' height='150' width='150' /><div style='display: flex; flex-direction: column; gap: 5px;'><span style='font-size: 24px;'>"+res[i].nom+"</span><span><b>Montant à l'unité : </b>"+res[i].montant+" €</span>"
      if (username){
        div.innerHTML += "<input type='number' min='1' id='eff"+i+"' value='1' /><button id='b"+i+"'>Acheter</button>"
      }
          div.innerHTML += "<br /><div class='no_display' id='dc"+i+"'></div></div></div>";

    moneys.appendChild(div);
    moneys.appendChild(document.createElement('hr'));

    if (username) {
      // ➕ Ajouter les champs dynamiquement dans le bloc paiement
      const container = document.getElementById("dc" + i);

      container.innerHTML = "<div id='card-element-"+i+"' style='margin-bottom: 10px;background-color: white;color:black;'></div><div id='card-errors-"+i+"' class='red' style='margin-bottom: 10px;'></div><button id='v"+i+"'>Payer</button><button id='a"+i+"'>Annuler</button>";

      const elements = stripe.elements();
      const cardElement = elements.create("card");
      cardElement.mount("#card-element-"+i);
      cardElements[i] = cardElement;

      cardElement.on("change", (event) => {
        const errorDiv = document.getElementById("card-errors-" + i);
        if (event.error) {
          errorDiv.textContent = event.error.message;
        } else {
          errorDiv.textContent = "";
        }
      });

      // 🎯 Click sur "Acheter"
      document.getElementById("b" + i).addEventListener("click", () => {
        const eff = document.getElementById("eff" + i);
        if (eff.value && eff.value >= eff.min) {
          container.style.display = "block";
          eff.disabled = true;
          document.getElementById("v" + i).innerHTML = "Payer "+(eff.value * res[i].montant) + "€";
        } else {
          alert("Tu dois saisir un effectif supérieur ou égal à 1 pour "+res[i].nom);
        }
      });

      // ❌ Click sur "Annuler"
      document.getElementById("a" + i).addEventListener("click", () => {
        document.getElementById("dc" + i).style.display = "none";
        document.getElementById("eff" + i).disabled = false;
      });

      // ✅ Click sur "Payer"
      document.getElementById("v" + i).addEventListener("click", async () => {
        const eff = document.getElementById("eff" + i).value;

        const confirmMsg = "Es-tu sûr de vouloir payer "+eff+" "+res[i].nom.toLowerCase()+"(s) pour un total de "+(eff * res[i].montant)+" € ?";
        if (!confirm(confirmMsg)) return;

        try {
          const paymentIntentRes = await fetch('http://127.0.0.1:3334/create-payment-intent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount: eff * res[i].montant * 100, currency: 'eur' })
          });

          const { clientSecret } = await paymentIntentRes.json();

          const result = await stripe.confirmCardPayment(clientSecret, {
            payment_method: {
              card: cardElements[i],
              billing_details: { name: 'Jean Dupont' }
            }
          });

          if (result.error) {
            alert("Erreur : " + result.error.message);
          } else if (result.paymentIntent.status === 'succeeded') {
            alert("✅ Paiement réussi !");
            const repons = await fetch("http://127.0.0.1:3334/data/postgresql/compte");
            const rps = await repons.json();
            console.log(rps);
            console.log(rps.success);
              const indep = rps.findIndex(obj => obj.login == username);
              const cid = rps[indep].id;
            // Tu peux envoyer l’achat au backend ici :
            const responseP = await fetch("http://127.0.0.1:3334/shop/pay/"+cid, {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                monnaie: res[i].nom,
                effectif: eff
              })
            });

            const rp = await responseP.json();
            if (rp.success) {
              alert("Monnaie ajoutée !");
              location.reload();
            } else {
              alert(rp.message);
            }
          }
        } catch (error) {
          alert("Erreur de paiement : " + error);
        }
      });
    }
  }
}


    if(username){
        userInfo.innerHTML = "<img src='/account.webp' onclick='ouvrir("+'"info_account"'+")' class='pointer' alt='Profil' width='30' height='30' /><span>"+username+'</span><button onclick="ouvrir('+"'confirm_deconnect'"+')" class="buttond">Déconnexion</button>'
      } else {
        userInfo.innerHTML = "<img src='/account.webp' class='pointer' onclick='location.href = "+'"/login"'+"' alt='Profil' width='30' height='30'/><span>Se connecter</span>"
      }

      window.ouvrir = async function(div){
        document.getElementById(div).style.display = "block"
        document.getElementById(div).scrollTop = 0
        for (let i = 0 ; i < divs.length ; i++){
          if (divs[i] != div){
            fermer(divs[i])
          }
          if (div == "info_account"){
            const resp = await fetch("http://127.0.0.1:3334/data/postgresql/compte")
            const resu = await resp.json()
            const inu = resu.findIndex(obj => obj.login == username)
            document.getElementById("nickname").innerHTML = resu[inu].nickname
            document.getElementById("login").innerHTML = resu[inu].login
            document.getElementById("tel").innerHTML = resu[inu].tel
            let p = ""
            for (let i = 0 ; i < resu[inu].password.length ; i++){
              p += "*"
            }
            document.getElementById("password").innerHTML = p
          }
        }
      }

      window.fermer = function(div){
        document.getElementById(div).style.display = "none"
      }

       window.deconnecter = function() {
          Cookie.remove("username")
          location.reload()
      }
  </script>
</body>
</html>
