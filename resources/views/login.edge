<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>LOOTOPIA - Login</title>
  {{ style('style') }}
</head>
<body>
    <nav>
        <div class="nav-left">
          <ul class="nav-list">
            <li class="pointer" onclick="location.href = '/player'">Joueur</li>
            <li class="pointer" onclick="location.href = '/organisator'">Organisateur</li>
            <li class="pointer" onclick="location.href = '/recompenses'">Récompenses disponibles</li>
          </ul>
        </div>
      </nav>
      <section class="scroll_y_auto">
        <img src="/lootopia.webp" width="170" height="170" alt="LOOTOPIA" />
        <h1>Login : </h1>
        <table>
            <tbody>
                <tr><th>Email :</th><td><input type="text" placeholder="Email" id="mel" /></tr>
                <tr><th>Password :</th><td><input type="password" placeholder="Password" id="pwd"/><button onclick="showPwd()">Display password</button></td></tr>
                <tr><td colspan="2" class="no_display" id="incorrect">Les identifiants ne correspondent pas</td></tr>
                <tr><td><button class="bigbutton" id="loginBtn">Login</button></td><td><button class="bigbutton" onclick="location.href = '/signup'">Sign up</button></td></tr>
                <tr><td colSpan="2"><button style="width:51rem;" class="bigbutton" onclick="window.history.back()">Return to home</button></td></tr>
            </tbody>
        </table>
  </section>
    <footer>
      <div class="nav-right">
        <ul class="nav-list">
          <li>© 2025 Ashley RAKOTOARISOA<br />Projet réalisé dans le cadre de Sup de Vinci</li>
        </ul>
    </div>
  </footer>
    <script type='module'>
      import Cookie from 'https://cdn.jsdelivr.net/npm/js-cookie@3.0.1/dist/js.cookie.mjs'
        function showPwd() {
            const mdp = document.getElementById("pwd");
            mdp.type = mdp.type == "password" ? "text" : "password";
        }

          document.getElementById("loginBtn").addEventListener("click", async (e) => {
            e.preventDefault(); // évite le rechargement de la page

            const login = document.getElementById("mel").value;
            const password = document.getElementById("pwd").value;

            try {
              const response = await fetch("http://127.0.0.1:3334/login", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({ login, password })
              });

              const result = await response.json();

              if (result.success) {
                // redirige par exemple
                Cookie.set("username",document.getElementById("mel").value)
                location.href = "/home";
              } else {
                document.getElementById("incorrect").style.display = "table-cell";
                document.getElementById("incorrect").textContent = "Les identifiants ne correspondent pas.";
              }
            } catch (error) {
              console.error("Erreur de connexion :", error);
              document.getElementById("incorrect").style.display = "table-cell";
              document.getElementById("incorrect").textContent = "Erreur réseau.";
            }
          });
    </script>
</body>
</html>
