<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>LOOTOPIA - Signup</title>
  {{ style('style') }}
</head>
<body>
  <nav>
    <div class="nav-left">
          <ul class="nav-list">
            <li class="pointer" onclick="location.href = '/player'">Joueur</li>
            <li class="pointer" onclick="location.href = '/organisator'">Organisateur</li>
            <li class="pointer" onclick="location.href = '/recompenses'">Récompenses disponibles</li>
            <li class="pointer" onclick="location.href = '/marketplace'">Marketplace</li>
            <li class="pointer" onclick="location.href = '/shop'">Boutique</li>
          </ul>
        </div>
        <div class="nav-right" id="user-info">
      </div>
    </div>
  </nav>

  <section class="scroll_y_auto">
    <img src="/lootopia.webp" width="170" height="170" alt="LOOTOPIA" />
    <h1>Nouvelle chasse :</h1>
    <table>
      <tbody>
        <tr><th>Titre* :</th><td><input type="text" placeholder="Titre*" id="titre" /></td></tr>
        <tr><th>Description :</th><td><textarea placeholder="Description" id="description"></textarea></td></tr>
        <tr><th>Monde* :</th><td><select id="monde"><option value="">--</option><option value="Privé">Privé</option><option value="Publique">Publique</option></td></tr>
          <tr><th>Date de fin :</th><td><input type="date" id="df"/></td></tr>
          <tr><th>Nombre maximum de participants* :</th><td><input type="number" id="nbremax" min="2" /></td></tr>
          <tr><th>Délai (en jours)* :</th><td><input type="number" id="delaij" min="1" /></td></tr>
          <tr><th>Montant* :</th><td><input type="number" id="montant" step="0.01" min="0" /></td></tr>
          <tr id="marv" class="no_display"><th>Marque* :</th><td><select id="marn"><option value=''>Pas de marque</option></select></td></tr>
            <tr id="uv" class="no_display"><th>URL de ton image* :</th><td><input type="text" placeholder="URL complet" id="urn" /></td></tr>
          <tr id="empty" class="no_display rouge"><td colspan="2">Les champs avec * sont obligatoires</td></tr>
          <tr id="dfv" class="no_display rouge"><td colspan="2">La date de fin saisi n'est pas valide.</td></tr>
          <tr id="inf" class="no_display rouge"><td colspan="2">Le nombre maximum de participant ne doit pas être inférieur à 2. Le délai ne peut pas être inférieur à 1. Le montant ne doit pas être négatif.</td></tr>
          <tr id="error" class="no_display rouge"><td colspan="2">Une erreur s'est produite lors de l'ajout de la chasse</td></tr>
          <tr id="succes" class="no_display vert"><td colspan="2">Chasse ajouté avec succès</td></tr>
          <tr id="iu" class="no_display rouge"><td colspan="2">L'URL saisi est incorrect. Il doit commencer par http:// ou https://</td></tr>
        <tr>
          <td><button class="bigbutton" id="valid">Valider</button></td>
          <td><button class="bigbutton" onclick="location.href = '/organisator'">Retour</button></td>
        </tr>
      </tbody>
    </table>
  </section>

  <footer>
    <div class="nav-right">
      <ul class="nav-list">
        <li>© 2025 Ashley RAKOTOARISOA<br />Projet réalisé dans le cadre de Sup de Vinci</li>
      </ul>
    </div>
  </footer>
    <script type="module">
        import Cookie from 'https://cdn.jsdelivr.net/npm/js-cookie@3.0.1/dist/js.cookie.mjs'
      const username = Cookie.get('username')
      let userInfo = document.getElementById('user-info')

    if(username){
        userInfo.innerHTML = "<img src='/account.webp' class='pointer' alt='Profil' width='30' height='30' /><span>"+username+"</span><button onclick='deconnecter()' class='buttond'>Déconnexion</button>"
      } else {
        location.href = "/"
      }

      document.getElementById("nbremax").value = 2
      document.getElementById("delaij").value = 1
      document.getElementById("montant").value = 0.00

       window.deconnecter = function() {
        var con = confirm("Are you sure ?")
        if (con){
          Cookie.remove("username")
          location.href = "/"
        }
      }

      async function chargement() {
        const response = await fetch("http://127.0.0.1:3334/data/postgresql/compte")
        const r = await response.json()
        const indexu = r.findIndex(obj => obj.login == username)
        if (r[indexu].is_partner == true){
          document.getElementById("marv").style.display = "block"
          document.getElementById("uv").style.display = "table-cell"
          const t = document.getElementById("marn")
          const response0 = await fetch("http://127.0.0.1:3334/partenaires/images")
          const r0 = await response0.json()
          for (let i = 0 ; i < r0.length ; i++){
            t.innerHTML += "<option value='"+r0[i]+"'>"+r0[i]+"</option>"
          }
        }
      }
      chargement()

      document.getElementById("valid").addEventListener("click", async (e) => {
            e.preventDefault();
            document.getElementById("empty").style.display = "none"
            document.getElementById("dfv").style.display = "none"
            document.getElementById("inf").style.display = "none"
            document.getElementById("error").style.display = "none"
            document.getElementById("iu").style.display = "none"
            document.getElementById("succes").style.display = "none"
            const dv = new Date(document.getElementById("df").value)
            console.log(document.getElementById("df").value)
            if (document.getElementById("titre").value == "" || document.getElementById("monde").selectedIndex == 0 ||document.getElementById("nbremax").value == "" ||document.getElementById("delaij").value == "" || document.getElementById("montant").value == ""){
              document.getElementById("empty").style.display = "table-cell"
            } else if (document.getElementById("df").value != "" && dv <= date) {
              document.getElementById("dfv").style.display = "table-cell"
            } else if (parseInt(document.getElementById("nbremax").value) < 2 ||parseInt(document.getElementById("delaij").value) < 1 || parseFloat(document.getElementById("montant").value) < 0.00){
              document.getElementById("inf").style.display = "table-cell"
            }else {
              const response = await fetch("http://127.0.0.1:3334/data/postgresql/compte")
              const result = await response.json()
              const indexu = result.findIndex(obj => obj.login == username)
              if (result[indexu].is_partner == true && (document.getElementById("marn").selectedIndex == 0 || document.getElementById("urn").value == "")) {
                document.getElementById("empty").style.display = "table-cell"
              } else if (result[indexu].is_partner == true && document.getElementById("urn").value.substring(0,8) != "https://" && document.getElementById("urn").value.substring(0,7) != "http://") {
                document.getElementById("iu").style.display = "table-cell"
              } else {
                try {
                  let marque,banniere
                  if (result[indexu].is_partner == true){
                    const m = document.getElementById("marn")
                    const im = m.selectedIndex
                    marque = m.options[im].value
                    banniere = document.getElementById("urn").value
                  } else {
                    marque = null
                    banniere = null
                  }
                  const titre =document.getElementById("titre").value
                  const description = document.getElementById("description").value
                  let fin = document.getElementById("df").value
                  if (fin == ""){
                    fin= null
                  }
                  const m = document.getElementById("monde")
                  const indexm = m.selectedIndex
                  const monde = m.options[indexm].value
                  const delai = parseInt(document.getElementById("delaij").value)
                  const montant = parseFloat(document.getElementById("montant").value)
                  const nbreparticipantsmax = parseInt(document.getElementById("nbremax").value)
                  const response0 = await fetch("http://127.0.0.1:3334/chasse", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ titre,description,organisateur:username,monde,fin,nbreparticipantsmax,montant,delai,marque,banniere })
                  });
                  const result0 = await response0.json();
                  document.getElementById("succes").style.display = "table-cell"
                  setTimeout(function () {
                    location.href = "/organisator"
                  }, 250);
                } catch (error) {
                  console.log(error)
                  document.getElementById("error").style.display = "table-cell"
                }
              }
            }
      })
    </script>
</body>
</html>
